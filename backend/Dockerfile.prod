# Build stage
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --frozen --no-install-project --no-dev

# Final stage
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    netcat-openbsd \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Place binaries in the path
ENV PATH="/app/.venv/bin:$PATH"

# Copy application code
COPY . .

# Create a non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup --home /home/appuser appuser && mkdir -p /home/appuser && chown appuser:appgroup /home/appuser

# Create directories for static and media with correct permissions
RUN mkdir -p /app/staticfiles /app/media /app/logs \
    && chown -R appuser:appgroup /app/staticfiles /app/media /app/logs /app


# Switch to non-root user
USER appuser
ENV HOME=/home/appuser

# Entrypoint
COPY ./entrypoint.prod.sh /entrypoint.prod.sh
USER root
RUN dos2unix /entrypoint.prod.sh && chmod +x /entrypoint.prod.sh
USER appuser

# Run using uv run to ensure environment is set (though PATH is set, uv run handles signals well)
ENTRYPOINT ["/entrypoint.prod.sh"]
