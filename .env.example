# ==========================================
# E-COMMERCE PROJECT CONFIGURATION
# ==========================================
# Rename this file to .env before use.
# Do NOT commit your actual .env file to git.

# ------------------------------------------
# 1. DJANGO SETTINGS (Backend)
# ------------------------------------------
# Generate a new random secret key (e.g., using `openssl rand -base64 32`)
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-secure-random-key

# Set to False in production
DEBUG=False

# Comma-separated list of domains that can access your API
ALLOWED_HOSTS=localhost,127.0.0.1,www.your-domain.com,backend

# ------------------------------------------
# 2. CORS & CSRF (Security)
# ------------------------------------------
# Where is your frontend running? (Comma-separated)
CORS_ALLOWED_ORIGINS=https://www.your-domain.com,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://www.your-domain.com,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------
# 3. DATABASE (PostgreSQL)
# ------------------------------------------
POSTGRES_DB=app_db
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------
# 4. REDIS (Caching & Channels)
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------
# 5. EMAIL (SMTP)
# ------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ------------------------------------------
# 6. EXTERNAL APIS
# ------------------------------------------
# Google Gemini AI
GEMINI_API_KEY=your-gemini-key

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------
# 7. FRONTEND (Next.js)
# ------------------------------------------
# Client-side URL (Browser) - Must include https:// in production
NEXT_PUBLIC_API_URL=https://www.your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://www.your-domain.com/
# Server-side URL (Docker Internal) - Usually defaults to http://backend:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1 

# ------------------------------------------
# 8. DOCKER DEPLOYMENT
# ------------------------------------------
# Ports exposed by containers to the host (Nginx proxies to these)
# Change these if you are running a second instance on the same server (e.g. 8001/3001)
BACKEND_PORT=8000
FRONTEND_PORT=3000
